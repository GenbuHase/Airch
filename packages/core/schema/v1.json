{
  "$ref": "#/definitions/AirchManifest",
  "definitions": {
    "AirchManifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "project": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "root": {
              "type": "string",
              "default": "."
            }
          },
          "required": [
            "name",
            "architecture"
          ],
          "additionalProperties": false
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "allowed_imports": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "forbidden_imports": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "naming_convention": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "kebab-case",
                      "PascalCase",
                      "camelCase",
                      "snake_case",
                      "UPPER_CASE"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "file_naming_convention": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "kebab-case",
                        "PascalCase",
                        "camelCase",
                        "snake_case",
                        "UPPER_CASE"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required_files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "disallowed_files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "allow_unmatched_files": {
                "type": "boolean",
                "default": true
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "conventions": {
          "type": "object",
          "properties": {
            "typescript": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean",
                  "default": true
                },
                "export_style": {
                  "type": "string",
                  "enum": [
                    "named",
                    "default",
                    "allow-both"
                  ],
                  "default": "named"
                },
                "type_import_style": {
                  "type": "string",
                  "enum": [
                    "type-only",
                    "inline",
                    "any"
                  ],
                  "default": "type-only"
                },
                "prefer_interface": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "state_management": {
              "type": "string"
            },
            "testing": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": true
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "run"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "project",
        "structure"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}